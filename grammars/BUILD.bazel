load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:cc.bzl", "zig_c_archive")
load("//bazel:grammar.bzl", "twigz_grammar", "twigz_language_cdylib", "twigz_pack")

package(default_visibility = ["//visibility:public"])

exports_files([
    "lua.grammar",
    "luau.grammar",
    "javascript.grammar",
    "python.grammar",
    "families/lua-core.grammar",
    "fixtures/twiglet.grammar",
    "format_test.sh",
])

filegroup(
    name = "grammar_files",
    srcs = glob(["**/*.grammar"]),
)

sh_test(
    name = "format_test",
    srcs = ["format_test.sh"],
    args = [
        "$(location //tools/fmt:twigz-fmt)",
        "$(locations :grammar_files)",
        "$(locations //data:snapshot_sources)",
    ],
    data = [
        ":grammar_files",
        "//data:snapshot_sources",
        "//tools/fmt:twigz-fmt",
    ],
)

twigz_grammar(
    name = "lua",
    language = "lua",
    modules = {":families/lua-core.grammar": "lua.core"},
    root = "lua.grammar",
)

twigz_grammar(
    name = "luau",
    language = "luau",
    modules = {":families/lua-core.grammar": "lua.core"},
    root = "luau.grammar",
)

twigz_grammar(
    name = "javascript",
    language = "javascript",
    root = "javascript.grammar",
)

twigz_grammar(
    name = "python",
    language = "python",
    root = "python.grammar",
)

twigz_grammar(
    name = "twiglet",
    language = "twiglet",
    root = "fixtures/twiglet.grammar",
)

twigz_pack(
    name = "syntax_pack",
    grammars = [
        ":javascript",
        ":lua",
        ":luau",
        ":python",
        ":twiglet",
    ],
)

filegroup(
    name = "parser_csrcs",
    srcs = [":syntax_pack"],
    output_group = "csrcs",
)

filegroup(
    name = "scanners",
    srcs = [":syntax_pack"],
    output_group = "scanners",
)

_C_COPTS = [
    "-std=c11",
    "-fPIC",
    "-D_POSIX_C_SOURCE=200112L",
    "-D_DEFAULT_SOURCE",
]

zig_c_archive(
    name = "ts_c",
    srcs = ["@tree_sitter//:runtime_c"],
    copts = _C_COPTS,
    extra_srcs = [
        "@tree_sitter//:runtime_support",
        "@tree_sitter//:runtime_header_files",
    ],
    deps = ["@tree_sitter//:headers"],
)

zig_c_archive(
    name = "langs_c",
    srcs = [
        ":parser_csrcs",
        ":scanners",
    ],
    copts = _C_COPTS,
    extra_srcs = [
        "@tree_sitter//:runtime_support",
        "@tree_sitter//:runtime_header_files",
    ],
    deps = [
        ":ts_c",
        "@tree_sitter//:headers",
    ],
)

twigz_language_cdylib(
    name = "twiglet_cdylib",
    grammar = ":twiglet",
    soname = "libtwiglet.so",
)
