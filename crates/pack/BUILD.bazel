load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "pack",
    srcs = ["src/lib.rs"],
    crate_name = "twigz_pack",
    edition = "2021",
    deps = [
        "@twigz_crates//:rustc-hash",
        "@twigz_crates//:serde_json",
        "@twigz_crates//:sha2",
        "@tree_sitter//:generate",
    ],
)

rust_test(
    name = "pack_test",
    srcs = ["pack_test.rs"],
    crate_name = "twigz_pack_test",
    data = ["//tools/pack:twigz-pack"],
    edition = "2021",
    deps = [
        ":pack",
        "//crates/generate",
        "@twigz_crates//:serde_json",
        "@twigz_crates//:sha2",
    ],
)
